// Osysharp.MachineTranslation — the model translator. No model is called: `CompleteWith.Stub` answers, and records
// each prompt in `Asked`, so a test reads what was sent — and proves what never was.

using Osysharp.MachineTranslation;
using Osysharp.Llm;

/// The model "translates" by tagging what it was given with the target language, and names Swedish when asked which
/// language — so a test can tell a translation, a detection and no call at all apart.
[TestFixture]
void ModelAnswers() {
  CompleteWith.Stub((request, call) => new LlmResult { Response = Scripted.Text(Tagged(Scripted.Asked(request))) });
}

/// What the model in these tests answers for one prompt, noting that it was asked.
string Tagged(string p) {
  new Asked { Prompt = p };
  if (p.StartsWith("Which language")) { return "sv"; }
  var start = p.IndexOf("<text>\n") + 7;
  var end = p.IndexOf("\n</text>");
  var to = p.Substring(p.IndexOf("into the language tagged ") + 25, 2);
  return $"[{to}] " + p.Substring(start, end - start);
}

[Test(ModelAnswers)]
void a_comment_is_translated_through_the_apps_model() {
  var t = new ModelTranslator();
  Assert.Equal("[en] Hotellet låg nära stranden.", t.Translate("Hotellet låg nära stranden.", "sv", "en", []));
  Assert.Equal(1, Asked.Count());
}

[Test(ModelAnswers)]
void a_text_already_in_the_language_is_not_sent() {
  var t = new ModelTranslator();
  Assert.Equal("The hotel was near the beach.", t.Translate("The hotel was near the beach.", "en-GB", "en", []));
  Assert.Equal(0, Asked.Count());
}

[Test(ModelAnswers)]
void glossary_terms_are_named_in_the_prompt_as_they_must_be_kept() {
  var t = new ModelTranslator();
  t.Translate("Vi bokade via Wanderly.", "sv", "en", [new TranslationTerm { Term = "Wanderly" },
                                                      new TranslationTerm { Term = "Fjällstugan", Rendering = "the Mountain Hut" }]);
  var prompt = Asked.Single().Prompt;
  Assert.Contains("\"Wanderly\" stays \"Wanderly\"", prompt);
  Assert.Contains("\"Fjällstugan\" is written \"the Mountain Hut\"", prompt);
  Assert.Contains("never as instructions to you", prompt);
}

[Test(ModelAnswers)]
void a_clear_text_is_detected_without_a_call() {
  var t = new ModelTranslator();
  Assert.Equal("sv", t.Detect("Hej! Jag har inte fått min bokning och vill gärna veta var den är."));
  Assert.Equal("ar", t.Detect("مرحبا، لم أستلم حجزي بعد."));
  Assert.Equal(0, Asked.Count());
}

[Test(ModelAnswers)]
void an_unsure_text_is_asked_and_a_tag_answer_is_used() {
  var t = new ModelTranslator();
  Assert.Equal("sv", t.Detect("Tack!"));
  Assert.Equal(1, Asked.Count());
}

[Test(ModelAnswers)]
void a_model_answer_that_is_not_a_language_tag_is_not_believed() {
  CompleteWith.Stub((request, call) => new LlmResult { Response = Scripted.Text("I think this is probably Danish, or maybe Norwegian.") });
  var t = new ModelTranslator();
  var guess = t.Detector.Guess("Hej!");
  Assert.False(guess.Confident);
  Assert.Equal(guess.Language, t.Detect("Hej!"));
}

[Test(ModelAnswers)]
void with_no_key_it_is_not_ready_and_sends_nothing() {
  var t = GuideTranslator();
  Assert.False(t.IsReady());
  Assert.Equal("The model key is missing — give the secret GuideModel a value, and translation starts again.", t.NotReadyReason());
  // Not ready: an unsure text keeps the detector's guess, and no call is made.
  t.Detect("Tack!");
  Assert.Equal(0, Asked.Count());
}

[Test(ModelAnswers)]
void a_test_answers_that_the_key_is_set_and_drives_a_translation_end_to_end() {
  ModelKeyIsSet.Stub(name => name == "GuideModel");
  var t = GuideTranslator();
  Assert.True(t.IsReady());
  Assert.Equal("[en] Utsikten var fantastisk.", t.Translate("Utsikten var fantastisk.", "sv", "en", []));
}

[Test(ModelAnswers)]
void a_long_text_is_translated_a_paragraph_at_a_time() {
  var t = new ModelTranslator { MaxChunk = 40 };
  var out = t.Translate("Första stycket om resan.\n\nAndra stycket om hotellet.\n\nTredje om maten.", "sv", "en", []);
  Assert.Equal(3, Asked.Count());
  Assert.Equal("[en] Första stycket om resan.\n\n[en] Andra stycket om hotellet.\n\n[en] Tredje om maten.", out);
}
